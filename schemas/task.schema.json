{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fourscience/copilot-loop/schemas/task.schema.json",
  "title": "Copilot Loop task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "goal", "acceptance", "gates"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "default": []
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 1000 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
              "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "required": { "type": "boolean", "default": true },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "gates": { "type": "array", "items": { "$ref": "#/definitions/gateRef" } }
                }
              }
            }
          }
        ]
      }
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/gateId" }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gates"],
        "properties": {
          "description": { "type": "string" },
          "gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/gateRef" } }
        }
      },
      "default": {}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 500, "default": 30 },
        "max_same_failure": { "type": "integer", "minimum": 1, "maximum": 50, "default": 3 },
        "max_agent_turns": { "type": "integer", "minimum": 1, "maximum": 200, "default": 30 },
        "max_no_progress": { "type": "integer", "minimum": 1, "maximum": 50, "default": 2 },
        "max_agent_runs": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 120 },
        "max_review_rejections": { "type": "integer", "minimum": 1, "maximum": 50, "default": 3 }
      },
      "default": {}
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoints": { "type": "boolean", "default": false }
      },
      "default": {}
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 2000, "maximum": 2000000 },
        "relevant_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "default": {}
    },
    "protected_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    }
  },
  "definitions": {
    "gateId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "gateRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(\\.[A-Za-z0-9][A-Za-z0-9_./-]{0,127})?$" }
  }
}
